 // Constructor launches the thread and waits until it goes to sleep
 // in idle_loop(). Note that 'searching' and 'exit' should be already set.
+#ifdef SF_SINGLE_THREADED
+
+// Single-threaded build (WebAssembly): there is no worker thread, every job
+// runs inline on the calling thread. `go` therefore blocks until the search is
+// over, which is exactly what we want inside a Web Worker.
+Thread::Thread(Search::SharedState&                    sharedState,
+               std::unique_ptr<Search::ISearchManager> sm,
+               size_t                                  n,
+               OptionalThreadToNumaNodeBinder          binder) :
+    idx(n),
+    nthreads(sharedState.options["Threads"]) {
+
+    searching       = false;
+    numaAccessToken = binder();
+    worker = std::make_unique<Search::Worker>(sharedState, std::move(sm), n, numaAccessToken);
+}
+
+Thread::~Thread() {}
+
+void Thread::start_searching() { worker->start_searching(); }
+
+void Thread::clear_worker() { worker->clear(); }
+
+void Thread::wait_for_search_finished() {}
+
+void Thread::run_custom_job(std::function<void()> f) {
+    if (f)
+        f();
+}
+
+void Thread::idle_loop() {}
+
+void Thread::ensure_network_replicated() { worker->ensure_network_replicated(); }
+
+#else
